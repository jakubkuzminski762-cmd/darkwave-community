diff --git a/.github/workflows/build_conductor_steam.yml b/.github/workflows/build_conductor_steam.yml
new file mode 100644
index 0000000000000000000000000000000000000000..daba8a40e415732faba61e3360b06c375124b8fb
--- /dev/null
+++ b/.github/workflows/build_conductor_steam.yml
@@ -0,0 +1,78 @@
+name: Build conductor mode for Steam
+
+on:
+  workflow_dispatch:
+  push:
+    branches:
+      - feature/conductor-mode-mvp
+      - maszyna-conductor-build
+
+permissions:
+  contents: read
+
+env:
+  CONFIG_WIN: RelWithDebInfo
+
+jobs:
+  windows-package:
+    name: Windows x64 Steam package
+    runs-on: windows-2022
+
+    steps:
+      - name: Checkout repository
+        uses: actions/checkout@v6
+        with:
+          fetch-depth: 0
+          submodules: recursive
+
+      - name: Setup Python 3.14
+        id: python
+        uses: actions/setup-python@v6
+        with:
+          python-version: "3.14"
+          architecture: x64
+
+      - name: Prepare Windows dependencies
+        shell: cmd
+        run: call setup.bat
+
+      - name: Configure
+        shell: pwsh
+        run: |
+          $pythonExe = "${{ steps.python.outputs.python-path }}"
+          $pythonRoot = Split-Path $pythonExe
+
+          cmake -S . -B build `
+            -G "Visual Studio 17 2022" `
+            -A x64 `
+            "-DPython3_ROOT_DIR=$pythonRoot" `
+            -DADD_VERSION_SUFFIX=OFF
+
+      - name: Build
+        shell: pwsh
+        run: |
+          cmake --build build `
+            --config $env:CONFIG_WIN `
+            --parallel
+
+      - name: Copy shaders
+        shell: pwsh
+        run: |
+          $output = "build/bin/$env:CONFIG_WIN"
+          New-Item -ItemType Directory -Force -Path "$output/shaders" | Out-Null
+          Copy-Item -Path "shaders/*" -Destination "$output/shaders" -Recurse -Force
+
+      - name: Make Steam installer
+        shell: pwsh
+        run: |
+          ./packaging/steam/package-windows.ps1 `
+            -BuildOutput "build/bin/$env:CONFIG_WIN" `
+            -OutputDirectory dist
+
+      - name: Upload Steam installer
+        uses: actions/upload-artifact@v4
+        with:
+          name: Maszyna-Conductor-Steam
+          path: dist/Maszyna-Conductor-Steam.zip
+          if-no-files-found: error
+          retention-days: 14
