+
+#pragma once
+
+#include <string>
+
+#include "input/command.h"
+#include "simulation/conductortickets.h"
+
+class TCamera;
+class TTrain;
+
+namespace simulation {
+
+class conductor_session {
+public:
+    void update(TTrain *train, TCamera &camera);
+
+    void request_toggle() { m_toggle_requested = true; }
+    void request_seat_toggle() { m_seat_toggle_requested = true; }
+    void request_departure_signal() { m_departure_signal_requested = true; }
+    void request_ticket_inspection() { m_ticket_inspection_requested = true; }
+    void request_ticket_resolution(conductor_duty::ticket_resolution resolution);
+    void request_door_command(user_command command);
+
+    bool active() const { return m_active; }
+    bool seated() const { return m_seated; }
+    std::string const &status() const { return m_status; }
+    std::string train_name() const;
+
+    conductor_duty::ticket_round const &tickets() const { return m_tickets; }
+
+    // Constrains a camera-space point to a simple passenger-compartment volume.
+    // This is deliberately data-independent so the prototype works with existing
+    // EN57 assets; per-vehicle walk meshes can replace it later.
+    glm::dvec3 clamp_inside(glm::dvec3 const &point) const;
+
+private:
+    bool activate(TTrain *train, TCamera &camera);
+    void deactivate(bool controller_is_valid = true);
+    void toggle_seat(TCamera &camera);
+    void send_departure_signal();
+    void inspect_ticket();
+    void resolve_ticket();
+    glm::dvec3 standing_position() const;
+    glm::dvec3 seat_position() const;
+
+    TTrain *m_train { nullptr };
+    bool m_active { false };
+    bool m_seated { false };
+    bool m_toggle_requested { false };
+    bool m_seat_toggle_requested { false };
+    bool m_departure_signal_requested { false };
+    bool m_ticket_inspection_requested { false };
+    bool m_ticket_resolution_requested { false };
+    conductor_duty::ticket_resolution m_requested_resolution { conductor_duty::ticket_resolution::none };
+    user_command m_door_command { user_command::none };
+    glm::dvec3 m_standing_position {};
+    std::string m_status { "Tryb konduktora jest wylaczony" };
+    conductor_duty::ticket_round m_tickets;
+    command_relay m_relay;
+};
+
+extern conductor_session Conductor;
+
+} // namespace simulation
diff --git a/simulation/conductortickets.cpp b/simulation/conductortickets.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..58cd5c2eedb30e6da21de31fbf1c11bf7869bd2e
--- /dev/null
+++ b/simulation/conductortickets.cpp
@@ -0,0 +1,120 @@
+/*
+This Source Code Form is subject to the terms of the Mozilla Public License, v.
+2.0. If a copy of the MPL was not distributed with this file, You can obtain one
+at http://mozilla.org/MPL/2.0/.
+*/
+
+#include "simulation/conductortickets.h"
+
+#include <algorithm>
+#include <iterator>
+
+namespace conductor_duty {
+
+void ticket_round::reset(std::size_t const passenger_count) {
+    m_passengers.clear();
+    m_passengers.reserve(passenger_count);
+    m_current.reset();
+    m_score = 0;
+
+    // Stable distribution makes duties reproducible and easy to test. Most
+    // passengers have valid tickets; every few passengers create a gameplay case.
+    constexpr ticket_state pattern[] = {
+        ticket_state::valid,
+        ticket_state::valid,
+        ticket_state::missing,
+        ticket_state::valid,
+        ticket_state::discount_without_document,
+        ticket_state::valid,
+        ticket_state::wrong_train,
+        ticket_state::valid
+    };
+
+    for (std::size_t index = 0; index < passenger_count; ++index) {
+        m_passengers.push_back({
+            static_cast<int>(index + 1),
+            static_cast<int>(index + 1),
+            pattern[index % std::size(pattern)],
+            ticket_resolution::none,
+            false
+        });
+    }
+}
+
+passenger_ticket *ticket_round::inspect_next() {
+    if (m_current && *m_current < m_passengers.size()
+     && m_passengers[*m_current].resolution == ticket_resolution::none) {
+        return &m_passengers[*m_current];
+    }
+
+    auto const lookup = std::find_if(
+        m_passengers.begin(), m_passengers.end(),
+        [](passenger_ticket const &passenger) { return !passenger.inspected; });
+
+    if (lookup == m_passengers.end()) {
+        m_current.reset();
+        return nullptr;
+    }
+
+    lookup->inspected = true;
+    m_current = static_cast<std::size_t>(std::distance(m_passengers.begin(), lookup));
+
+    if (lookup->state == ticket_state::valid) {
+        lookup->resolution = ticket_resolution::accepted;
+        ++m_score;
+    }
+
+    return &*lookup;
+}
+
+bool ticket_round::resolve_current(ticket_resolution const resolution) {
+    if (!m_current || *m_current >= m_passengers.size()) {
+        return false;
+    }
+
+    auto &passenger = m_passengers[*m_current];
+    if (!passenger.inspected || passenger.resolution != ticket_resolution::none) {
+        return false;
+    }
+
+    switch (resolution) {
+    case ticket_resolution::fare_issued:
+        m_score += passenger.state == ticket_state::missing ? 2 : 1;
+        break;
+    case ticket_resolution::penalty_issued:
+        m_score += 3;
+        break;
+    case ticket_resolution::ignored:
+        m_score -= 2;
+        break;
+    default:
+        return false;
+    }
+
+    passenger.resolution = resolution;
+    return true;
+}
+
+passenger_ticket const *ticket_round::current() const {
+    return m_current && *m_current < m_passengers.size() ? &m_passengers[*m_current] : nullptr;
+}
+
+std::size_t ticket_round::inspected_count() const {
+    return static_cast<std::size_t>(std::count_if(
+        m_passengers.begin(), m_passengers.end(),
+        [](passenger_ticket const &passenger) { return passenger.inspected; }));
+}
+
+std::size_t ticket_round::resolved_count() const {
+    return static_cast<std::size_t>(std::count_if(
+        m_passengers.begin(), m_passengers.end(),
+        [](passenger_ticket const &passenger) {
+            return passenger.resolution != ticket_resolution::none;
+        }));
+}
+
+bool ticket_round::complete() const {
+    return !m_passengers.empty() && resolved_count() == m_passengers.size();
+}
+
+} // namespace conductor_duty
diff --git a/simulation/conductortickets.h b/simulation/conductortickets.h
new file mode 100644
index 0000000000000000000000000000000000000000..1661de54b743fc79f159c6c3802b1f9094d8972a
--- /dev/null
+++ b/simulation/conductortickets.h
