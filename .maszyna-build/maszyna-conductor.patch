+void TController::SetManualConductor(bool const enabled) {
+    m_manualconductor = enabled;
+    m_conductorready = false;
+    if (enabled) {
+        // A virtual guard signal left over from regular AI operation must not
+        // authorize a departure after the player takes the conductor role.
+        iDrivigFlags &= ~moveGuardSignal;
+    }
+}
+
+conductor_signal_result TController::ConductorReadySignal() {
+    if (!AIControllFlag) {
+        return conductor_signal_result::ai_inactive;
+    }
+    if (std::abs(mvOccupied->Vel) >= EU07_AI_NOMOVEMENT) {
+        return conductor_signal_result::train_moving;
+    }
+    if (!IsAtPassengerStop) {
+        return conductor_signal_result::not_at_passenger_stop;
+    }
+    if (doors_open() || doors_permit_active()) {
+        return conductor_signal_result::doors_not_secured;
+    }
+
+    m_conductorready = true;
+    iDrivigFlags |= moveGuardSignal;
+    return conductor_signal_result::accepted;
+}
