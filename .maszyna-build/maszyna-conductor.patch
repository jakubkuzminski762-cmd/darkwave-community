+/*
+This Source Code Form is subject to the terms of the Mozilla Public License, v.
+2.0. If a copy of the MPL was not distributed with this file, You can obtain one
+at http://mozilla.org/MPL/2.0/.
+*/
+
+#include "stdafx.h"
+#include "application/conductorpanel.h"
+
+#include "simulation/conductor.h"
+
+conductor_panel::conductor_panel()
+    : ui_panel("Conductor duty", true) {
+    title = "Sluzba konduktora";
+    size_min = {360, 260};
+    size_max = {520, 720};
+}
+
+char const *conductor_panel::ticket_state_label(conductor_duty::ticket_state const state) {
+    switch (state) {
+    case conductor_duty::ticket_state::valid:
+        return "Bilet wazny";
+    case conductor_duty::ticket_state::missing:
+        return "Brak biletu";
+    case conductor_duty::ticket_state::wrong_train:
+        return "Bilet na inny pociag";
+    case conductor_duty::ticket_state::discount_without_document:
+        return "Brak dokumentu do ulgi";
+    }
+    return "Nieznany";
+}
+
+void conductor_panel::render_contents() {
+    auto &session = simulation::Conductor;
+
+    ImGui::TextWrapped("%s", session.status().c_str());
+    ImGui::Separator();
+
+    if (!session.active()) {
+        ImGui::TextWrapped(
+            "F8 uruchamia tryb konduktora. Maszynista AI przejmie prowadzenie pociagu.");
+        if (ImGui::Button("Rozpocznij sluzbe (F8)")) {
+            session.request_toggle();
+        }
+        return;
+    }
+
+    ImGui::Text("Sklad: %s", session.train_name().c_str());
+    ImGui::Text("Pozycja: %s", session.seated() ? "miejsce konduktora" : "przejscie wagonu");
+
+    if (ImGui::Button(session.seated() ? "Wstan (C)" : "Usiadz (C)")) {
+        session.request_seat_toggle();
+    }
+    ImGui::SameLine();
+    if (ImGui::Button("Zakoncz sluzbe")) {
+        session.request_toggle();
+    }
+
+    ImGui::Separator();
+    ImGui::TextUnformatted("Obsluga drzwi");
+    if (ImGui::Button("Otworz lewe")) {
+        session.request_door_command(user_command::dooropenleft);
+    }
+    ImGui::SameLine();
+    if (ImGui::Button("Otworz prawe")) {
+        session.request_door_command(user_command::dooropenright);
+    }
+    if (ImGui::Button("Zamknij wszystkie")) {
+        session.request_door_command(user_command::doorcloseall);
+    }
+    if (ImGui::Button("Gotow do odjazdu (V)")) {
+        session.request_departure_signal();
+    }
+
+    ImGui::Separator();
+    ImGui::TextUnformatted("Kontrola biletow");
+    auto const &tickets = session.tickets();
+    ImGui::Text(
+        "Sprawdzone: %zu/%zu   Wynik: %d",
+        tickets.inspected_count(), tickets.passengers().size(), tickets.score());
+
+    auto const *current = tickets.current();
+    if (current != nullptr) {
+        ImGui::Text("Pasazer %d, miejsce %d", current->passenger_id, current->seat_number);
+        ImGui::Text("%s", ticket_state_label(current->state));
+
+        if (current->resolution == conductor_duty::ticket_resolution::none) {
+            if (ImGui::Button("Wystaw bilet")) {
+                session.request_ticket_resolution(conductor_duty::ticket_resolution::fare_issued);
+            }
+            ImGui::SameLine();
+            if (ImGui::Button("Oplata dodatkowa")) {
+                session.request_ticket_resolution(conductor_duty::ticket_resolution::penalty_issued);
+            }
+            if (ImGui::Button("Pomin naruszenie")) {
+                session.request_ticket_resolution(conductor_duty::ticket_resolution::ignored);
+            }
+        }
+    }
+
+    if (!tickets.complete() && ImGui::Button("Sprawdz kolejnego (E)")) {
+        session.request_ticket_inspection();
+    }
+    if (tickets.complete()) {
+        ImGui::TextUnformatted("Kontrola zakonczona.");
+    }
+}
