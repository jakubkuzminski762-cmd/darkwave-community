+
+#pragma once
+
+#include <cstddef>
+#include <optional>
+#include <vector>
+
+namespace conductor_duty {
+
+enum class ticket_state {
+    valid,
+    missing,
+    wrong_train,
+    discount_without_document
+};
+
+enum class ticket_resolution {
+    none,
+    accepted,
+    fare_issued,
+    penalty_issued,
+    ignored
+};
+
+struct passenger_ticket {
+    int passenger_id { 0 };
+    int seat_number { 0 };
+    ticket_state state { ticket_state::valid };
+    ticket_resolution resolution { ticket_resolution::none };
+    bool inspected { false };
+};
+
+// Small, deterministic gameplay model used by the conductor prototype. Visual
+// passenger actors can be bound to these records without changing ticket rules.
+class ticket_round {
+public:
+    void reset(std::size_t passenger_count = 12);
+
+    passenger_ticket *inspect_next();
+    bool resolve_current(ticket_resolution resolution);
+
+    passenger_ticket const *current() const;
+    std::vector<passenger_ticket> const &passengers() const { return m_passengers; }
+
+    std::size_t inspected_count() const;
+    std::size_t resolved_count() const;
+    bool complete() const;
+    int score() const { return m_score; }
+
+private:
+    std::vector<passenger_ticket> m_passengers;
+    std::optional<std::size_t> m_current;
+    int m_score { 0 };
+};
+
+} // namespace conductor_duty
diff --git a/tests/conductortickets_test.cpp b/tests/conductortickets_test.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..7189b98587ad7cacdde5965b96c3ef00d7562cd3
--- /dev/null
+++ b/tests/conductortickets_test.cpp
@@ -0,0 +1,44 @@
+#include "simulation/conductortickets.h"
+
+#include <cassert>
+
+int main() {
+    conductor_duty::ticket_round round;
+    round.reset(8);
+
+    assert(round.passengers().size() == 8);
+    assert(round.score() == 0);
+
+    auto *first = round.inspect_next();
+    assert(first != nullptr);
+    assert(first->state == conductor_duty::ticket_state::valid);
+    assert(first->resolution == conductor_duty::ticket_resolution::accepted);
+    assert(round.score() == 1);
+
+    auto *second = round.inspect_next();
+    assert(second != nullptr);
+    assert(second->state == conductor_duty::ticket_state::valid);
+
+    auto *third = round.inspect_next();
+    assert(third != nullptr);
+    assert(third->state == conductor_duty::ticket_state::missing);
+    assert(third->resolution == conductor_duty::ticket_resolution::none);
+    assert(round.inspect_next() == third);
+    assert(round.resolve_current(conductor_duty::ticket_resolution::fare_issued));
+    assert(round.score() == 4);
+
+    while (!round.complete()) {
+        auto *passenger = round.inspect_next();
+        if (passenger == nullptr) {
+            break;
+        }
+        if (passenger->resolution == conductor_duty::ticket_resolution::none) {
+            assert(round.resolve_current(conductor_duty::ticket_resolution::penalty_issued));
+        }
+    }
+
+    assert(round.complete());
+    assert(round.inspected_count() == 8);
+    assert(round.resolved_count() == 8);
+    return 0;
+}
