diff --git a/packaging/steam/uninstall.ps1 b/packaging/steam/uninstall.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..050f78b626646e196f95a01b0e82f5dd3ebd208e
--- /dev/null
+++ b/packaging/steam/uninstall.ps1
@@ -0,0 +1,69 @@
+param(
+    [Parameter(Mandatory = $false)]
+    [string]$GameDirectory = ""
+)
+
+$ErrorActionPreference = "Stop"
+
+try {
+    if ([string]::IsNullOrWhiteSpace($GameDirectory)) {
+        $GameDirectory = Split-Path $PSScriptRoot -Parent
+    }
+
+    $backupRoot = Join-Path $GameDirectory "conductor_mode_backup"
+    $manifestPath = Join-Path $backupRoot "manifest.tsv"
+
+    if (-not (Test-Path $manifestPath -PathType Leaf)) {
+        $defaultSteamPath = Join-Path ${env:ProgramFiles(x86)} "Steam\steamapps\common\MaSzyna"
+        $defaultManifest = Join-Path $defaultSteamPath "conductor_mode_backup\manifest.tsv"
+        if (Test-Path $defaultManifest -PathType Leaf) {
+            $GameDirectory = $defaultSteamPath
+            $backupRoot = Join-Path $GameDirectory "conductor_mode_backup"
+            $manifestPath = $defaultManifest
+        }
+    }
+
+    if (-not (Test-Path $manifestPath -PathType Leaf)) {
+        throw @"
+Nie znaleziono kopii utworzonej przez instalator.
+W Steam wybierz: Wlasciwosci > Zainstalowane pliki > Sprawdz spojnosc plikow.
+"@
+    }
+
+    $GameDirectory = (Resolve-Path $GameDirectory).Path
+    Write-Host "Przywracanie plikow w: $GameDirectory"
+
+    foreach ($line in Get-Content $manifestPath) {
+        $parts = $line -split "`t", 2
+        if ($parts.Count -ne 2) {
+            continue
+        }
+
+        $action = $parts[0]
+        $relativePath = $parts[1]
+        $destination = Join-Path $GameDirectory $relativePath
+
+        if ($action -eq "RESTORE") {
+            $backup = Join-Path $backupRoot $relativePath
+            if (-not (Test-Path $backup -PathType Leaf)) {
+                throw "Brakuje kopii pliku: $relativePath"
+            }
+            New-Item -ItemType Directory -Path (Split-Path $destination -Parent) -Force | Out-Null
+            Copy-Item $backup $destination -Force
+        } elseif ($action -eq "REMOVE") {
+            if (Test-Path $destination -PathType Leaf) {
+                Remove-Item $destination -Force
+            }
+        }
+    }
+
+    Remove-Item (Join-Path $GameDirectory "conductor_mode.installed") -Force -ErrorAction SilentlyContinue
+    Remove-Item $backupRoot -Recurse -Force
+
+    Write-Host "Oryginalne pliki zostaly przywrocone."
+    exit 0
+} catch {
+    Write-Host "BLAD: $($_.Exception.Message)" -ForegroundColor Red
+    Write-Host "Zamknij MaSzyne i Steam. W razie odmowy dostepu uruchom uninstall.bat jako administrator."
+    exit 1
+}
diff --git a/simulation/conductor.cpp b/simulation/conductor.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..df06201d31a6c46d845a3e366f4b9abcf87d40a7
--- /dev/null
+++ b/simulation/conductor.cpp
@@ -0,0 +1,267 @@
+/*
+This Source Code Form is subject to the terms of the Mozilla Public License, v.
+2.0. If a copy of the MPL was not distributed with this file, You can obtain one
+at http://mozilla.org/MPL/2.0/.
+*/
+
+#include "stdafx.h"
+#include "simulation/conductor.h"
+
+#include "utilities/Globals.h"
+#include "vehicle/Camera.h"
+#include "vehicle/Driver.h"
+#include "vehicle/DynObj.h"
+#include "vehicle/Train.h"
+
+namespace simulation {
+
+conductor_session Conductor;
+
+void conductor_session::request_ticket_resolution(
+    conductor_duty::ticket_resolution const resolution) {
+    m_requested_resolution = resolution;
+    m_ticket_resolution_requested = true;
+}
+
+void conductor_session::request_door_command(user_command const command) {
+    switch (command) {
+    case user_command::dooropenleft:
+    case user_command::dooropenright:
+    case user_command::doorcloseall:
+        m_door_command = command;
+        break;
+    default:
+        break;
+    }
+}
+
+void conductor_session::update(TTrain *train, TCamera &camera) {
+    if (m_toggle_requested) {
+        m_toggle_requested = false;
+        if (m_active) {
+            deactivate(train == m_train);
+        }
+        else {
+            activate(train, camera);
+        }
+    }
+
+    if (!m_active) {
+        return;
+    }
+
+    if (train == nullptr || train != m_train || train->Dynamic() == nullptr) {
+        deactivate(false);
+        m_status = "Sluzba przerwana: sklad nie jest juz dostepny";
+        return;
+    }
+
+    if (camera.m_owner != train->Dynamic()) {
+        camera.m_owner = train->Dynamic();
+    }
+
+    if (m_seat_toggle_requested) {
+        m_seat_toggle_requested = false;
+        toggle_seat(camera);
+    }
+
+    if (m_departure_signal_requested) {
+        m_departure_signal_requested = false;
+        send_departure_signal();
+    }
+
+    if (m_ticket_inspection_requested) {
+        m_ticket_inspection_requested = false;
+        inspect_ticket();
+    }
+
+    if (m_ticket_resolution_requested) {
+        m_ticket_resolution_requested = false;
+        resolve_ticket();
+    }
+
+    if (m_door_command != user_command::none) {
+        m_relay.post(m_door_command, 0.0, 0.0, GLFW_PRESS, train->id());
+        if (m_door_command == user_command::doorcloseall) {
+            m_status = "Polecenie zamkniecia drzwi zostalo wyslane";
+        }
+        else {
+            m_status = "Polecenie otwarcia drzwi zostalo wyslane";
+        }
+        m_door_command = user_command::none;
+    }
+
+    if (m_seated) {
+        camera.Velocity = {};
+        camera.m_owneroffset = seat_position();
+    }
+    else {
+        camera.m_owneroffset = clamp_inside(camera.m_owneroffset);
+        m_standing_position = camera.m_owneroffset;
+    }
+
+    // The normal cab camera cache is also used by the renderer. Keep it aligned
+    // with the conductor camera so regular camera code does not snap back to cab.
+    train->pMechOffset = camera.m_owneroffset;
+}
+
+bool conductor_session::activate(TTrain *train, TCamera &camera) {
+    if (train == nullptr || train->Dynamic() == nullptr || train->Dynamic()->Mechanik == nullptr) {
+        m_status = "Nie mozna rozpoczac sluzby bez aktywnego skladu";
+        return false;
+    }
+
+    m_train = train;
+    m_active = true;
+    m_seated = false;
+    m_tickets.reset();
+
+    // The player is the conductor; the existing controller remains responsible
+    // for driving the train and obeying the timetable and signals.
+    auto *controller = train->Dynamic()->Mechanik;
+    controller->TakeControl(true);
+    controller->SetManualConductor(true);
+
+    FreeFlyModeFlag = false;
+    camera.Reset();
+    camera.m_owner = train->Dynamic();
+    camera.Velocity = {};
+    camera.m_owneroffset = standing_position();
+    camera.LookAt = camera.m_owner->GetWorldPosition(camera.m_owneroffset)
+                  + camera.m_owner->VectorFront() * 5.0;
+    train->pMechOffset = camera.m_owneroffset;
+    train->pMechSittingPosition = seat_position();
+    train->Dynamic()->bDisplayCab = true;
+
+    m_standing_position = camera.m_owneroffset;
+    m_status = "Sluzba rozpoczeta. Maszynista AI prowadzi pociag";
+    return true;
+}
+
+void conductor_session::deactivate(bool const controller_is_valid) {
+    if (controller_is_valid && m_train != nullptr && m_train->Dynamic() != nullptr
+     && m_train->Dynamic()->Mechanik != nullptr) {
+        m_train->Dynamic()->Mechanik->SetManualConductor(false);
+    }
+
+    m_train = nullptr;
+    m_active = false;
+    m_seated = false;
+    m_seat_toggle_requested = false;
+    m_departure_signal_requested = false;
+    m_ticket_inspection_requested = false;
+    m_ticket_resolution_requested = false;
+    m_door_command = user_command::none;
+    m_status = "Tryb konduktora jest wylaczony";
+}
+
+void conductor_session::toggle_seat(TCamera &camera) {
+    m_seated = !m_seated;
+    camera.Velocity = {};
+    if (m_seated) {
+        m_standing_position = clamp_inside(camera.m_owneroffset);
+        camera.m_owneroffset = seat_position();
+        m_status = "Siedzisz na miejscu konduktora";
+    }
+    else {
+        camera.m_owneroffset = clamp_inside(m_standing_position);
+        m_status = "Wstales z miejsca konduktora";
+    }
+}
+
+void conductor_session::send_departure_signal() {
+    if (m_train == nullptr || m_train->Dynamic() == nullptr
+     || m_train->Dynamic()->Mechanik == nullptr) {
+        m_status = "Brak lacznosci z maszynista";
+        return;
+    }
+
+    switch (m_train->Dynamic()->Mechanik->ConductorReadySignal()) {
+    case conductor_signal_result::accepted:
+        m_status = "Sygnał gotow do odjazdu zostal przekazany maszyniscie";
+        break;
+    case conductor_signal_result::ai_inactive:
+        m_status = "Sygnał odrzucony: pociagu nie prowadzi maszynista AI";
+        break;
+    case conductor_signal_result::train_moving:
+        m_status = "Sygnał odrzucony: pociag jest w ruchu";
+        break;
+    case conductor_signal_result::not_at_passenger_stop:
+        m_status = "Sygnał odrzucony: pociag nie stoi przy peronie";
+        break;
+    case conductor_signal_result::doors_not_secured:
+        m_status = "Sygnał odrzucony: drzwi nie sa zamkniete i zablokowane";
+        break;
+    }
+}
+
+void conductor_session::inspect_ticket() {
+    auto const *current = m_tickets.current();
+    if (current != nullptr && current->resolution == conductor_duty::ticket_resolution::none) {
+        m_status = "Najpierw zakoncz sprawe poprzedniego pasazera";
+        return;
+    }
+
+    auto *passenger = m_tickets.inspect_next();
+    if (passenger == nullptr) {
+        m_status = "Kontrola biletow zostala zakonczona";
+        return;
+    }
+
+    m_status = "Sprawdzono pasazera nr " + std::to_string(passenger->passenger_id);
+}
+
+void conductor_session::resolve_ticket() {
+    if (m_tickets.resolve_current(m_requested_resolution)) {
+        m_status = "Sprawa biletowa zostala zakonczona";
+    }
+    else {
+        m_status = "Najpierw sprawdz bilet pasazera";
+    }
+    m_requested_resolution = conductor_duty::ticket_resolution::none;
+}
+
+glm::dvec3 conductor_session::standing_position() const {
+    if (m_train == nullptr || m_train->Dynamic() == nullptr) {
+        return {};
+    }
+    auto const &dimensions = m_train->Dynamic()->MoverParameters->Dim;
+    return {0.0, std::clamp(0.55 * dimensions.H, 1.55, 1.8), 0.0};
+}
+
+glm::dvec3 conductor_session::seat_position() const {
+    if (m_train == nullptr || m_train->Dynamic() == nullptr) {
+        return {};
+    }
+    auto const &dimensions = m_train->Dynamic()->MoverParameters->Dim;
+    return {
+        dimensions.W * 0.22,
+        std::clamp(0.48 * dimensions.H, 1.35, 1.65),
+        -dimensions.L * 0.32
+    };
+}
+
+glm::dvec3 conductor_session::clamp_inside(glm::dvec3 const &point) const {
+    if (!m_active || m_train == nullptr || m_train->Dynamic() == nullptr || DebugModeFlag) {
+        return point;
+    }
+
+    auto const &dimensions = m_train->Dynamic()->MoverParameters->Dim;
+    if (m_seated) {
+        return seat_position();
+    }
+    auto const eye_height = std::clamp(0.55 * dimensions.H, 1.55, 1.8);
+    return {
+        std::clamp(point.x, -0.40 * dimensions.W, 0.40 * dimensions.W),
+        eye_height,
+        std::clamp(point.z, -0.43 * dimensions.L, 0.43 * dimensions.L)
+    };
+}
+
+std::string conductor_session::train_name() const {
+    return m_train != nullptr && m_train->Dynamic() != nullptr
+        ? m_train->Dynamic()->name()
+        : std::string{};
+}
+
+} // namespace simulation
