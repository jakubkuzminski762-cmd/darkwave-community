--- /dev/null
+++ b/packaging/steam/install.bat
@@ -0,0 +1,17 @@
+@echo off
+setlocal EnableExtensions
+
+title MaSzyna - instalator trybu konduktora
+
+powershell.exe -NoProfile -ExecutionPolicy Bypass -File "%~dp0install.ps1" -GameDirectory "%~1"
+set "RESULT=%ERRORLEVEL%"
+
+echo.
+if "%RESULT%"=="0" (
+    echo GOTOWE. Uruchom MaSzyne normalnie przez Steam.
+    echo W grze nacisnij F8, aby rozpoczac sluzbe konduktora.
+) else (
+    echo Instalacja nie zostala zakonczona. Kod bledu: %RESULT%
+)
+pause
+exit /b %RESULT%
diff --git a/packaging/steam/install.ps1 b/packaging/steam/install.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..73b306af8f9a3e0d86f692b6676581c628d0d695
--- /dev/null
+++ b/packaging/steam/install.ps1
@@ -0,0 +1,86 @@
+param(
+    [Parameter(Mandatory = $false)]
+    [string]$GameDirectory = ""
+)
+
+$ErrorActionPreference = "Stop"
+
+try {
+    $packageRoot = $PSScriptRoot
+    $runtimeRoot = Join-Path $packageRoot "Runtime"
+
+    if (-not (Test-Path (Join-Path $runtimeRoot "eu07.exe") -PathType Leaf)) {
+        throw "W paczce brakuje Runtime\eu07.exe. Pobierz i rozpakuj kompletne archiwum ZIP."
+    }
+
+    if ([string]::IsNullOrWhiteSpace($GameDirectory)) {
+        $GameDirectory = Split-Path $packageRoot -Parent
+    }
+
+    if (-not (Test-Path (Join-Path $GameDirectory "eu07.exe") -PathType Leaf)) {
+        $defaultSteamPath = Join-Path ${env:ProgramFiles(x86)} "Steam\steamapps\common\MaSzyna"
+        if (Test-Path (Join-Path $defaultSteamPath "eu07.exe") -PathType Leaf) {
+            $GameDirectory = $defaultSteamPath
+        }
+    }
+
+    if (-not (Test-Path (Join-Path $GameDirectory "eu07.exe") -PathType Leaf)) {
+        throw @"
+Nie znaleziono folderu gry MaSzyna.
+Rozpakuj folder Maszyna-Conductor-Steam bezposrednio do folderu gry albo
+przeciagnij folder gry na install.bat.
+Folder znajdziesz w Steam: Biblioteka > MaSzyna > Zarzadzaj > Przegladaj pliki lokalne.
+"@
+    }
+
+    $GameDirectory = (Resolve-Path $GameDirectory).Path
+    $backupRoot = Join-Path $GameDirectory "conductor_mode_backup"
+    $manifestPath = Join-Path $backupRoot "manifest.tsv"
+    $knownPaths = [System.Collections.Generic.HashSet[string]]::new(
+        [System.StringComparer]::OrdinalIgnoreCase
+    )
+
+    New-Item -ItemType Directory -Path $backupRoot -Force | Out-Null
+
+    if (Test-Path $manifestPath -PathType Leaf) {
+        foreach ($line in Get-Content $manifestPath) {
+            $parts = $line -split "`t", 2
+            if ($parts.Count -eq 2) {
+                [void]$knownPaths.Add($parts[1])
+            }
+        }
+    }
+
+    Write-Host "Folder gry: $GameDirectory"
+    Write-Host "Tworzenie kopii i instalowanie plikow..."
+
+    foreach ($source in Get-ChildItem $runtimeRoot -File -Recurse) {
+        $relativePath = $source.FullName.Substring($runtimeRoot.Length).TrimStart([char[]]"\/")
+        $destination = Join-Path $GameDirectory $relativePath
+
+        if (-not $knownPaths.Contains($relativePath)) {
+            if (Test-Path $destination -PathType Leaf) {
+                $backup = Join-Path $backupRoot $relativePath
+                New-Item -ItemType Directory -Path (Split-Path $backup -Parent) -Force | Out-Null
+                Copy-Item $destination $backup -Force
+                Add-Content -Path $manifestPath -Value ("RESTORE`t" + $relativePath) -Encoding UTF8
+            } else {
+                Add-Content -Path $manifestPath -Value ("REMOVE`t" + $relativePath) -Encoding UTF8
+            }
+            [void]$knownPaths.Add($relativePath)
+        }
+
+        New-Item -ItemType Directory -Path (Split-Path $destination -Parent) -Force | Out-Null
+        Copy-Item $source.FullName $destination -Force
+    }
+
+    Set-Content -Path (Join-Path $GameDirectory "conductor_mode.installed") `
+        -Value "MaSzyna Conductor Mode" -Encoding ASCII
+
+    Write-Host "Zainstalowano tryb konduktora."
+    exit 0
+} catch {
+    Write-Host "BLAD: $($_.Exception.Message)" -ForegroundColor Red
+    Write-Host "Zamknij MaSzyne i Steam. W razie odmowy dostepu uruchom install.bat jako administrator."
+    exit 1
+}
diff --git a/packaging/steam/package-windows.ps1 b/packaging/steam/package-windows.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..9e4964f2fb65849fabebf12e753c4cd407c2e323
--- /dev/null
+++ b/packaging/steam/package-windows.ps1
@@ -0,0 +1,50 @@
+param(
+    [Parameter(Mandatory = $true)]
+    [string]$BuildOutput,
+
+    [Parameter(Mandatory = $false)]
+    [string]$OutputDirectory = "$PSScriptRoot\..\..\dist"
+)
+
+$ErrorActionPreference = "Stop"
+
+$buildPath = Resolve-Path $BuildOutput
+$executables = Get-ChildItem -Path $buildPath -Filter "eu07*.exe" -File
+
+if ($executables.Count -ne 1) {
+    throw "Expected exactly one eu07 executable in $buildPath, found $($executables.Count)."
+}
+
+$packageRoot = Join-Path $OutputDirectory "Maszyna-Conductor-Steam"
+$zipPath = Join-Path $OutputDirectory "Maszyna-Conductor-Steam.zip"
+
+if (Test-Path $packageRoot) {
+    Remove-Item -Recurse -Force $packageRoot
+}
+if (Test-Path $zipPath) {
+    Remove-Item -Force $zipPath
+}
+
+New-Item -ItemType Directory -Force -Path $packageRoot | Out-Null
+
+$runtimeRoot = Join-Path $packageRoot "Runtime"
+New-Item -ItemType Directory -Force -Path $runtimeRoot | Out-Null
+Copy-Item (Join-Path $buildPath "*") $runtimeRoot -Recurse -Force
+Copy-Item (Join-Path $PSScriptRoot "install.bat") $packageRoot
+Copy-Item (Join-Path $PSScriptRoot "install.ps1") $packageRoot
+Copy-Item (Join-Path $PSScriptRoot "uninstall.bat") $packageRoot
+Copy-Item (Join-Path $PSScriptRoot "uninstall.ps1") $packageRoot
+Copy-Item (Join-Path $PSScriptRoot "README_PL.txt") $packageRoot
+
+$binary = Get-Item (Join-Path $runtimeRoot $executables[0].Name)
+if ($binary.Length -lt 1MB) {
+    throw "Built executable is unexpectedly small: $($binary.Length) bytes."
+}
+
+$hash = Get-FileHash $binary.FullName -Algorithm SHA256
+"$($hash.Hash)  Runtime\$($binary.Name)" | Set-Content -Encoding ascii (Join-Path $packageRoot "SHA256SUM.txt")
+
+Compress-Archive -Path $packageRoot -DestinationPath $zipPath -CompressionLevel Optimal
+
+Write-Host "Created package: $zipPath"
+Write-Host "Executable SHA256: $($hash.Hash)"
